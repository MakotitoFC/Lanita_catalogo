{
  "name": "lanita",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "turbo run dev --filter=@lanita/web",
    "dev:mobile": "turbo run start --filter=@lanita/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:db": "node supabase/tests/db.test.mjs",
    "preview:web": "npm run build --workspace @lanita/web && npm run start --workspace @lanita/web"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "turbo": "^2.3.3",
    "typescript": "~5.6.3"
  }
}
