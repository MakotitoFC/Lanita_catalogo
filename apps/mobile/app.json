{
  "expo": {
    "name": "Lanita Admin",
    "slug": "lanita-admin",
    "scheme": "lanita",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Lanita usa la cámara para fotografiar productos, combos y comprobantes.",
          "photosPermission": "Lanita accede a tus fotos solo para adjuntar imágenes de productos o comprobantes."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#74784a"
        }
      ]
    ],
    "android": {
      "package": "com.lanita.admin",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.lanita.admin",
      "supportsTablet": false
    },
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "62139007-9c42-4ea0-9d0c-43ae0bb43554"
      }
    },
    "owner": "adamdkjbkje"
  }
}
